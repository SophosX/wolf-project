# Wolf Radar — Server-Umgebung (nach ../.env.server kopieren, NIE committen)

# Pflicht: KI-Analyse, Faktencheck, Skripte, Audio-Transkription
GEMINI_API_KEY=hier-eintragen

# Pflicht: YouTube-Claim-Suche + Watchlist (Data API v3)
YT_API_KEY=hier-eintragen

# Pflicht für Instagram (zuverlässiger Apify-Scraper; ohne Token nur Best-Effort)
APIFY_TOKEN=hier-eintragen

# Datenmodus: lokal = JSON-Dateien im daten-Volume (empfohlen für den VPS)
DATEN_MODUS=lokal

# Optionaler Zugangsschutz: einkommentieren, wenn die App nicht öffentlich
# bedienbar sein soll (offene App = jeder kann Faktenchecks/Skripte auslösen
# und verbraucht dein Gemini-Kontingent).
# RADAR_ZUGANGSCODE=wolfradar2026

# Optionales Tuning (Defaults sind gut):
# RADAR_MODELL_QUALITAET=gemini-2.5-pro
# RADAR_MODELL_SCHNELL=gemini-2.5-flash
# RADAR_QUERIES_PRO_LAUF=8
# RADAR_AUDIO_MAX=12
# RADAR_SUBS_COOLDOWN_S=1800
# RADAR_TIKTOK_DISCOVERY_MIN_VIEWS=10000
