# Caddy: automatisches HTTPS (Let's Encrypt) für beide Hosts.
# suessstoffmafia.de        -> statische Landing (landing/, Bind-Mount)
# radar.suessstoffmafia.de  -> Wolf-Radar-App (Container radar:3000)

{
	email business@sustinerin.de
}

suessstoffmafia.de {
	root * /srv/landing
	encode zstd gzip
	file_server
}

www.suessstoffmafia.de {
	redir https://suessstoffmafia.de{uri} permanent
}

radar.suessstoffmafia.de {
	encode zstd gzip
	reverse_proxy radar:3000
}
